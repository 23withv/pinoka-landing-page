---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicNavbar from "@/components/common/PublicNavbar.svelte";
import HeroScrollSequence from "@/components/landing/HeroScrollSequence.svelte";
import TextRevealSection from "@/components/landing/TextRevealSection.svelte";
import SynergySection from "@/components/landing/SynergySection.svelte";
import ValueMatrixSection from "@/components/landing/ValueMatrixSection.svelte";
import TestimonialsSection from "@/components/landing/TestimonialsSection.svelte";
import FaqSection from "@/components/landing/FaqSection.svelte";
import FinalCtaSection from "@/components/landing/FinalCtaSection.svelte";
import LandingFooter from "@/components/landing/LandingFooter.svelte";

const currentPath = Astro.url.pathname;
---

<BaseLayout
  title="Pinoka - Platform Digitalisasi Visual Produk Lokal Banyuwangi"
  description="Platform kolaborasi modern yang mempertemukan UMKM Banyuwangi dan desainer kreatif untuk mendigitalisasi visual produk lokal."
  hideNavbar={true}
>
  <div
    class="w-full bg-canvas text-main selection:bg-orange selection:text-white relative transition-colors duration-200"
  >
    <!-- Fixed Global Architectural Capsule Navbar -->
    <div
      class="fixed top-0 inset-x-0 z-50 w-full pointer-events-none hero-enter-nav"
    >
      <PublicNavbar client:idle currentPath={currentPath} />
    </div>

    <!-- Cinematic Scroll-Linked HTML5 Canvas Hero -->
    <HeroScrollSequence client:load />

    <!-- Theme-Responsive Architectural Post-Hero Sections -->
    <div class="relative w-full z-20 transition-colors duration-300">
      <TextRevealSection client:idle />
      <SynergySection client:idle />
      <ValueMatrixSection client:visible />
      <TestimonialsSection client:visible />
      <FaqSection client:visible />
      <FinalCtaSection />
      <LandingFooter client:visible />
    </div>
  </div>
</BaseLayout>
